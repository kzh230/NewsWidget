<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="15dp">
    <!-- padding(안 여백) 초기값은 16 -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 타이틀 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BREAKING NEWS"
            android:textColor="#D97757"
            android:textSize="12sp"
            android:textStyle="bold" />
        <!-- Original Colour #888888 -->

        <!-- 갱신 시간 -->
        <TextView
            android:id="@+id/text_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="터치하여 새로고침"
            android:textColor="#888888"
            android:textSize="10sp"
            android:textStyle="normal" />
        <!-- 초기값 Colour #555555 -->

        <!-- 구글 뉴스 앱을 열어주는 버튼 -->
        <TextView
            android:id="@+id/btn_open_news"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="뉴스 보기 >>"
            android:textColor="#1A73E8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
        <!-- 초기값 Size 10 -->

    </LinearLayout>

    <!-- 뉴스 본문 -->
    <TextView
        android:id="@+id/text_news_headline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="뉴스를 불러오는 중..."
        android:textColor="#F8F8F8"
        android:textSize="16sp"
        android:textStyle="normal" />
    <!-- 초기값 Colour #FFFFFF -->

</LinearLayout>